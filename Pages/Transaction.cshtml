@page
@model Watch_Reselling_System___Franco.Pages.TransactionModel

<style>
body {
    font-family: 'Segoe UI';
    background: #f1f5f9;
    padding: 30px;
}

.container {
    max-width: 1100px;
    margin: auto;
}

/* HEADER */
.header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
}

/* FILTER BUTTON */
.filter-toggle {
    width: 34px;
    height: 34px;
    border-radius: 8px;
    border: none;
    background: #e2e8f0;
    cursor: pointer;
}

/* CARD */
.card {
    background: white;
    padding: 20px;
    border-radius: 12px;
    margin-bottom: 20px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.05);
}

/* INPUT */
input, select {
    width: 100%;
    padding: 10px;
    margin-bottom: 10px;
    border-radius: 8px;
    border: 1px solid #cbd5e1;
}

/* BUTTON */
.main-btn {
    width: 100%;
    padding: 10px;
    border: none;
    border-radius: 8px;
    background: black;
    color: white;
}

/* TABLE */
table {
    width: 100%;
    border-collapse: collapse;
}

th, td {
    padding: 12px;
    border-bottom: 1px solid #e2e8f0;
}

th {
    background: #e2e8f0;
}

.action a {
    margin-right: 10px;
    font-weight: bold;
    text-decoration: none;
}

.edit { color: black; }
.delete { color: red; }

.error {
    color: red;
    margin-bottom: 10px;
}

/* 🔥 SLIDER PANEL */
.filter-panel {
    position: fixed;
    top: 0;
    right: -300px;
    width: 280px;
    height: 100%;
    background: white;
    box-shadow: -4px 0 15px rgba(0,0,0,0.1);
    padding: 20px;
    transition: 0.3s;
    z-index: 1000;
}

.filter-panel.active {
    right: 0;
}

.filter-header {
    display: flex;
    justify-content: space-between;
    margin-bottom: 20px;
}

.close-btn {
    cursor: pointer;
}
</style>

<div class="container">

    <!-- HEADER -->
    <div class="header">
        <h2>Transactions</h2>
        <button class="filter-toggle" onclick="toggleFilter()">⚙</button>
    </div>

    <!-- ERROR -->
    @if (TempData["Error"] != null)
    {
        <div class="error">@TempData["Error"]</div>
    }

    <!-- 🔥 SLIDER FILTER -->
    <div id="filterPanel" class="filter-panel">

        <div class="filter-header">
            <strong>Filter</strong>
            <span class="close-btn" onclick="toggleFilter()">✖</span>
        </div>

        <form method="get">

            <select name="SelectedClientId">
                <option value="">All Clients</option>

                @foreach (var c in Model.Clients)
                {
                    <option value="@c.ClientId"
                        selected="@(Model.SelectedClientId == c.ClientId ? "selected" : null)">
                        @c.FirstName @c.LastName
                    </option>
                }
            </select>

            <button class="main-btn">Apply</button>

        </form>
    </div>

    <!-- FORM -->
    <div class="card">
        <form method="post">

            <input type="hidden" name="Current.TransactionId" value="@Model.Current.TransactionId" />

            <!-- CLIENT -->
            <select name="Current.ClientId" required>
                @foreach (var c in Model.Clients)
                {
                    <option value="@c.ClientId"
                        selected="@(Model.Current.ClientId == c.ClientId ? "selected" : null)">
                        @c.FirstName @c.LastName
                    </option>
                }
            </select>

            <!-- WATCH -->
            <select id="watchSelect" name="Current.WatchId" required>
                @foreach (var w in Model.Watches)
                {
                    <option value="@w.watch_id"
                            data-price="@w.price"
                            disabled="@(w.stock <= 0 ? "disabled" : null)"
                            selected="@(Model.Current.WatchId == w.watch_id ? "selected" : null)">
                        @w.watch_modelname (₱@w.price | Stock:@w.stock)
                    </option>
                }
            </select>

            <!-- TYPE -->
            <select name="Current.TransactionType">
                <option value="Sell">Sell (to client)</option>
                <option value="Buy">Buy (from client)</option>
            </select>

            <!-- PRICE -->
            <input id="priceInput" readonly placeholder="Price" />

            <!-- QUANTITY -->
            <input type="number" name="Current.Quantity" min="1" required placeholder="Quantity" />

            <button class="main-btn">
                @(Model.IsEdit ? "Update Transaction" : "Add Transaction")
            </button>

        </form>
    </div>

    <!-- TABLE -->
    <div class="card">
        <table>
            <thead>
                <tr>
                    <th>Client</th>
                    <th>Watch</th>
                    <th>Type</th>
                    <th>Qty</th>
                    <th>Price</th>
                    <th>Total</th>
                    <th>Date</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>
            @foreach (var t in Model.TransactionList)
            {
                <tr>
                    <td>@t.ClientName</td>
                    <td>@t.WatchName</td>
                    <td>@t.TransactionType</td>
                    <td>@t.Quantity</td>
                    <td>₱@t.Price</td>
                    <td>₱@(t.Price * t.Quantity)</td>
                    <td>@t.TransactionDate.ToShortDateString()</td>
                    <td class="action">
                        <a class="edit" href="?EditId=@t.TransactionId">Edit</a>
                        <a class="delete"
                           href="?DeleteId=@t.TransactionId"
                           onclick="return confirm('Delete?')">Delete</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>

</div>

<!-- JS -->
<script>
const watchSelect = document.getElementById("watchSelect");
const priceInput = document.getElementById("priceInput");

function updatePrice() {
    const selected = watchSelect.options[watchSelect.selectedIndex];
    priceInput.value = selected.getAttribute("data-price") || 0;
}

watchSelect.addEventListener("change", updatePrice);

function toggleFilter() {
    document.getElementById("filterPanel").classList.toggle("active");
}

// KEEP PANEL OPEN AFTER FILTER
window.onload = function () {
    updatePrice();

    const selected = "@Model.SelectedClientId";
    if (selected) {
        document.getElementById("filterPanel").classList.add("active");
    }
}
</script>