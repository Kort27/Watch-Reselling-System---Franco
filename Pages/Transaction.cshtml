@page
@model Watch_Reselling_System___Franco.Pages.TransactionModel

<style>
body {
    font-family: 'Segoe UI';
    background: #f1f5f9;
    padding: 30px;
}

.container {
    max-width: 1100px;
    margin: auto;
}

.header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
}

.card {
    background: white;
    padding: 20px;
    border-radius: 12px;
    margin-bottom: 20px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.05);
}

input, select {
    width: 100%;
    padding: 10px;
    margin-bottom: 10px;
    border-radius: 8px;
    border: 1px solid #cbd5e1;
}

.main-btn {
    width: 100%;
    padding: 10px;
    border: none;
    border-radius: 8px;
    background: black;
    color: white;
}

table {
    width: 100%;
    border-collapse: collapse;
}

th, td {
    padding: 12px;
    border-bottom: 1px solid #e2e8f0;
}

th {
    background: #e2e8f0;
}

.action a {
    margin-right: 10px;
    text-decoration: none;
    font-weight: bold;
}

.edit { color: #000; }
.delete { color: red; }

.error {
    color: red;
    margin-bottom: 10px;
}
</style>

<div class="container">

    <!-- HEADER -->
    <div class="header">
        <h2>Transactions</h2>
    </div>

    <!-- ERROR -->
    @if (TempData["Error"] != null)
    {
        <div class="error">@TempData["Error"]</div>
    }

    <!-- FORM -->
    <div class="card">
        <form method="post">

            <input type="hidden" name="Current.TransactionId" value="@Model.Current.TransactionId" />

            <!-- CLIENT -->
            <select name="Current.ClientId" required>
                @foreach (var c in Model.Clients)
                {
                    <option value="@c.ClientId"
                        selected="@(Model.Current.ClientId == c.ClientId ? "selected" : null)">
                        @c.FirstName @c.LastName
                    </option>
                }
            </select>

            <!-- WATCH -->
            <select id="watchSelect" name="Current.WatchId" required>
                @foreach (var w in Model.Watches)
                {
                    <option value="@w.watch_id"
                            data-price="@w.price"
                            disabled="@(w.stock <= 0 ? "disabled" : null)"
                            selected="@(Model.Current.WatchId == w.watch_id ? "selected" : null)">
                        @w.watch_modelname (₱@w.price | Stock:@w.stock)
                    </option>   
                }
            </select>

            <!-- TYPE -->
            <select name="Current.TransactionType" required>
                <option value="Sell" selected="@(Model.Current.TransactionType == "Sell" ? "selected" : null)">
                    Sell (to client)
                </option>
                <option value="Buy" selected="@(Model.Current.TransactionType == "Buy" ? "selected" : null)">
                    Buy (from client)
                </option>
            </select>

            <!-- PRICE (AUTO) -->
            <input type="number" id="priceInput" readonly placeholder="Price" />

            <!-- QUANTITY -->
            <input type="number" name="Current.Quantity" min="1" required placeholder="Quantity" />

            <!-- TOTAL -->
            <input type="text" id="total" readonly placeholder="Total" />

            <button class="main-btn">
                @(Model.IsEdit ? "Update Transaction" : "Add Transaction")
            </button>

        </form>
    </div>

    <!-- TABLE -->
    <div class="card">
        <table>
            <thead>
                <tr>
                    <th>Client</th>
                    <th>Watch</th>
                    <th>Type</th>
                    <th>Quantity</th>
                    <th>Price</th>
                    <th>Total</th>
                    <th>Date</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>
                @foreach (var t in Model.TransactionList)
                {
                    <tr>
                        <td>@t.ClientName</td>
                        <td>@t.WatchName</td>
                        <td>@t.TransactionType</td>
                        <td>@t.Quantity</td>
                        <td>₱@t.Price</td>
                        <td>₱@(t.Price * t.Quantity)</td>
                        <td>@t.TransactionDate.ToShortDateString()</td>
                        <td class="action">
                            <a class="edit" href="?EditId=@t.TransactionId">Edit</a>
                            <a class="delete"
                               href="?DeleteId=@t.TransactionId"
                               onclick="return confirm('Delete this transaction?')">
                                Delete
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>

<!-- JS -->
<script>
const watchSelect = document.getElementById("watchSelect");
const priceInput = document.getElementById("priceInput");
const qtyInput = document.getElementById("qtyInput");
const total = document.getElementById("total");

function updatePrice() {
    const selected = watchSelect.options[watchSelect.selectedIndex];
    const price = selected.getAttribute("data-price") || 0;
    priceInput.value = price;
    updateTotal();
}

function updateTotal() {
    const price = parseFloat(priceInput.value) || 0;
    const qty = parseInt(qtyInput.value) || 0;
    total.value = "₱" + (price * qty);
}

watchSelect.addEventListener("change", updatePrice);
qtyInput.addEventListener("input", updateTotal);

window.onload = function () {
    updatePrice();
};
</script>