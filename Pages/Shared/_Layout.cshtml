<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Watch System</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <style>
            body {
                font-family: 'Segoe UI', sans-serif;
                background: #f1f5f9;
                margin: 0;
            }

            /* MAIN WRAPPER */
            .container-main {
                max-width: 1100px;
                margin: auto;
                padding: 20px;
            }

            /* NAVBAR */
            .navbar-custom {
                max-width: 1100px;
                margin: 20px auto;
                display: flex;
                justify-content: space-between;
                align-items: center;
                background: rgba(255,255,255,0.8);
                backdrop-filter: blur(10px);
                padding: 12px 20px;
                border-radius: 12px;
                box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            }

            /* LOGO */
            .logo a {
                font-weight: bold;
                font-size: 18px;
                color: #0f172a;
                text-decoration: none;
            }

            /* NAV BUTTONS */
            .nav-links {
                display: flex;
                gap: 8px;
            }

            .nav-btn {
                padding: 6px 14px;
                border-radius: 8px;
                font-size: 14px;
                text-decoration: none;
                background: #e2e8f0;
                color: #0f172a;
                transition: 0.2s;
            }

                .nav-btn:hover {
                    background: #cbd5e1;
                }

            /* ACTIVE */
            .active-nav {
                background: black !important;
                color: white !important;
            }

            /* FOOTER */
            footer {
                text-align: center;
                padding: 20px;
                color: #64748b;
            }
    </style>
</head>

<body>

    <!-- NAVBAR -->
    <header>
        <div class="navbar-custom">

            <div class="logo">
                <a asp-page="/Index">⌚ Watch Reselling System</a>
            </div>

            <div class="nav-links">
                <a asp-page="/Index"
                       class="nav-btn @(Context.Request.Path == "/" ? "active-nav" : "")">
                    Home
                </a>

                <a asp-page="/Clients"
                       class="nav-btn @(Context.Request.Path.StartsWithSegments("/Clients") ? "active-nav" : "")">
                    Clients
                </a>

                <a asp-page="/Watch"
                       class="nav-btn @(Context.Request.Path.StartsWithSegments("/Watch") ? "active-nav" : "")">
                    Watches
                </a>

                <a asp-page="/Transaction"
                       class="nav-btn @(Context.Request.Path.StartsWithSegments("/Transaction") ? "active-nav" : "")">
                    Transactions
                </a>
            </div>

        </div>
    </header>

    <!-- MAIN CONTENT -->
    <div class="container-main">
        @RenderBody()
    </div>

    <!-- FOOTER -->
    <footer>
        &copy; 2026 - Watch Reselling System
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>