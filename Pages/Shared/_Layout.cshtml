<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Watch System</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <style>
            /* ===== GLOBAL BACKGROUND ===== */
            body {
                font-family: 'Segoe UI', sans-serif;
                margin: 0;
                padding: 0;
                background: url('/watch.jpg') no-repeat center center fixed;
                background-size: cover;
            }

                /* DARK OVERLAY */
                body::before {
                    content: "";
                    position: fixed;
                    inset: 0;
                    background: rgba(0,0,0,0.55);
                    z-index: -1;
                }

            /* ===== NAVBAR ===== */
            .navbar-custom {
                max-width: 1100px;
                margin: 20px auto;
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 12px 20px;
                background: rgba(255,255,255,0.1);
                backdrop-filter: blur(12px);
                border-radius: 12px;
                box-shadow: 0 5px 20px rgba(0,0,0,0.4);
            }

            .logo a {
                color: white;
                font-weight: bold;
                font-size: 18px;
                text-decoration: none;
            }

            /* NAV LINKS */
            .nav-links {
                display: flex;
                gap: 8px;
            }

            .nav-btn {
                padding: 6px 14px;
                border-radius: 8px;
                text-decoration: none;
                font-size: 14px;
                background: rgba(255,255,255,0.2);
                color: white;
                transition: 0.2s;
            }

                .nav-btn:hover {
                    background: rgba(255,255,255,0.35);
                }

            .active-nav {
                background: white !important;
                color: black !important;
                font-weight: bold;
            }

            /* ===== MAIN CONTENT ===== */
            .container-main {
                max-width: 1100px;
                margin: auto;
                padding: 20px;
            }

            /* ===== CARD GLOBAL ===== */
            .card {
                background: rgba(255,255,255,0.12);
                backdrop-filter: blur(12px);
                padding: 20px;
                border-radius: 12px;
                margin-bottom: 20px;
                color: white;
                box-shadow: 0 6px 20px rgba(0,0,0,0.4);
            }

            /* ===== INPUTS ===== */
            input, select {
                width: 100%;
                padding: 10px;
                margin: 8px 0;
                border-radius: 8px;
                border: none;
                background: rgba(255,255,255,0.2);
                color: white;
            }

                input::placeholder {
                    color: #ddd;
                }

            /* ===== BUTTON ===== */
            button {
                width: 100%;
                padding: 10px;
                border: none;
                border-radius: 8px;
                background: white;
                color: black;
                font-weight: bold;
            }

            /* ===== TABLE ===== */
            table {
                width: 100%;
                border-collapse: collapse;
                color: white;
            }

            th {
                background: rgba(255,255,255,0.15);
            }

            td {
                border-bottom: 1px solid rgba(255,255,255,0.2);
                padding: 10px;
            }

            .action a {
                margin-right: 10px;
                color: white;
                font-weight: bold;
            }

            /* ===== FOOTER ===== */
            footer {
                text-align: center;
                padding: 20px;
                color: #cbd5e1;
            }
    </style>
</head>

<body>

    <!-- NAVBAR -->
    <header>
        <div class="navbar-custom">

            <div class="logo">
                <a asp-page="/Index">⌚ Watch Reselling System</a>
            </div>

            <div class="nav-links">
                <a asp-page="/Index"
                       class="nav-btn @(Context.Request.Path == "/" ? "active-nav" : "")">
                    Home
                </a>

                <a asp-page="/Clients"
                       class="nav-btn @(Context.Request.Path.StartsWithSegments("/Clients") ? "active-nav" : "")">
                    Clients
                </a>

                <a asp-page="/Watch"
                       class="nav-btn @(Context.Request.Path.StartsWithSegments("/Watch") ? "active-nav" : "")">
                    Watches
                </a>

                <a asp-page="/Transaction"
                       class="nav-btn @(Context.Request.Path.StartsWithSegments("/Transaction") ? "active-nav" : "")">
                    Transactions
                </a>
            </div>

        </div>
    </header>

    <!-- MAIN -->
    <div class="container-main">
        @RenderBody()
    </div>

    <!-- FOOTER -->
    <footer>
        &copy; 2026 - Watch Reselling System
    </footer>

</body>
</html>