@page
@model Watch_Reselling_System___Franco.Pages.IndexModel

<style>
/* ===== BODY BACKGROUND ===== */
body {
    font-family: 'Segoe UI', sans-serif;
    margin: 0;
    padding: 40px;

    background: url('/watch.jpg') no-repeat center center fixed;
    background-size: cover;
}

/* DARK OVERLAY */
body::before {
    content: "";
    position: fixed;
    inset: 0;
    background: linear-gradient(
        rgba(0,0,0,0.6),
        rgba(0,0,0,0.4)
    );
    z-index: -1;
}

/* ===== CONTAINER ===== */
.container {
    max-width: 1100px;
    margin: auto;
}

/* ===== HEADER ===== */
.header {
    margin-bottom: 35px;
    color: white;
}

.header h1 {
    font-size: 34px;
    margin: 0;
    font-weight: bold;
}

.header p {
    opacity: 0.8;
    margin-top: 6px;
}

/* ===== GRID ===== */
.cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px;
}

/* ===== CARD ===== */
.card {
    position: relative;
    overflow: hidden;

    background: rgba(255,255,255,0.1);
    backdrop-filter: blur(12px);

    padding: 25px;
    border-radius: 16px;

    text-decoration: none;
    color: white;

    box-shadow: 0 10px 30px rgba(0,0,0,0.4);

    transition: all 0.3s ease;
}

/* GLOW EFFECT */
.card::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(120deg, transparent, rgba(255,255,255,0.2), transparent);
    opacity: 0;
    transition: 0.3s;
}

.card:hover::before {
    opacity: 1;
}

/* HOVER */
.card:hover {
    transform: translateY(-8px) scale(1.02);
}

/* TITLE */
.card h2 {
    margin-bottom: 10px;
    font-size: 20px;
}

/* SUBTEXT */
.card p {
    color: #cbd5e1;
    font-size: 14px;
}

/* COUNT */
.count {
    font-size: 34px;
    font-weight: bold;
    margin-top: 12px;
}

/* COLORS */
.green { color: #4ade80; }
.red { color: #f87171; }

/* LOW STOCK WARNING */
.warning {
    margin-top: 8px;
    font-size: 12px;
    color: #f87171;
}

/* ICON STYLE */
.icon {
    font-size: 22px;
    margin-bottom: 8px;
}

/* FOOTER SPACING */
.spacer {
    height: 20px;
}
</style>

<div class="container">

    <!-- HEADER -->
    <div class="header">
        <h1>Dashboard</h1>
        <p>Watch Reselling System Overview</p>
    </div>

    <!-- CARDS -->
    <div class="cards">

        <!-- CLIENTS -->
        <a asp-page="/Clients" class="card">
            <div class="icon">👤</div>
            <h2>Clients</h2>
            <p>Total registered clients</p>
            <div class="count">@Model.TotalClients</div>
        </a>

        <!-- WATCHES -->
        <a asp-page="/Watch" class="card">
            <div class="icon">⌚</div>
            <h2>Inventory</h2>
            <p>Total stock available</p>

            <div class="count @(Model.TotalStock == 0 ? "red" : "green")">
                @Model.TotalStock 
            </div>

            @if (Model.LowStockCount > 0)
            {
                <div class="warning">
                    @Model.LowStockCount items low / out of stock
                </div>
            }
        </a>

        <!-- TRANSACTIONS -->
        <a asp-page="/Transaction" class="card">
            <div class="icon">💳</div>
            <h2>Transactions</h2>
            <p>Total transactions recorded</p>
            <div class="count">@Model.TotalTransactions</div>
        </a>

    </div>

    <div class="spacer"></div>

</div>